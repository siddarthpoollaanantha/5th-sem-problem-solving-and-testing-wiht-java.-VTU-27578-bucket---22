public class CircularPalindromes {
    public static void main(String[] args) {
        String s = "cacbbba";
        int n = s.length();

        for (int k = 0; k < n; k++) {
            String rotation = s.substring(k) + s.substring(0, k);
            System.out.println(longestPalindromeLength(rotation));
        }
    }

    // Manacher's algorithm: returns length of longest palindromic substring
    public static int longestPalindromeLength(String s) {
        StringBuilder sb = new StringBuilder("^#");
        for (char c : s.toCharArray()) {
            sb.append(c).append('#');
        }
        sb.append('$');

        String t = sb.toString();
        int n = t.length();
        int[] p = new int[n];
        int center = 0, right = 0;
        int maxLen = 0;

        for (int i = 1; i < n - 1; i++) {
            if (i < right) {
                p[i] = Math.min(right - i, p[2 * center - i]);
            }
            while (t.charAt(i + p[i] + 1) == t.charAt(i - p[i] - 1)) {
                p[i]++;
            }
            if (i + p[i] > right) {
                center = i;
                right = i + p[i];
            }
            maxLen = Math.max(maxLen, p[i]);
        }

        return maxLen;
    }
}
